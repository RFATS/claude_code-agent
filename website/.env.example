# 공공데이터포털(data.go.kr) '국토교통부_아파트 매매 실거래가 자료'(15126469) 일반 인증키 — Decoding 키
# (Encoding 키를 넣으면 이중 인코딩되어 code 30 오류가 납니다)
DATA_GO_KR_API_KEY=

# real-estate-mcp 저장소 위치 (node scripts/setup-mcp.js --yes 로 내려받기)
MCP_DIR=vendor/real-estate-mcp

# 선택
# SOURCE=sample        # live|sample 강제. 기본: 키와 MCP_DIR 이 있으면 live, 없으면 sample
# PORT=3000
# DAILY_LIMIT=9000     # 일일 API 호출 상한(개발계정 10,000건에서 여유를 둠)
# CONCURRENCY=3        # 동시 API 호출 수
# SAMPLE_DELAY_MS=30   # 샘플 소스의 호출당 지연(진행률 UI 확인용)
